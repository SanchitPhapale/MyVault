# Server
PORT=3000

# Vault password (change this to your own password)
VITE_VAULT_PASSWORD=12345

# Session
SESSION_SECRET=change-this-to-a-long-random-secret

# Storage limit in bytes (default 10GB)
STORAGE_LIMIT=10737418240

# Max upload size per file in bytes (default 500MB)
MAX_FILE_SIZE=524288000

# Database

MONGODB_URI=

SESSION_SECRET=

IDRIVE_ENDPOINT=
IDRIVE_REGION=
IDRIVE_ACCESS_KEY_ID=
IDRIVE_SECRET_ACCESS_KEY=
IDRIVE_BUCKET_NAME=myvault-files